<% layout("/layouts/boilerplate") -%>

<h2 class="text-center mt-3 mb-4 fw-semibold">My Stays</h2>
<% if ( !bookings || bookings.length === 0) { %>
  <div >
    <div class="text-center mt-5 ">
      <h4>No bookings yet</h4>
      <p class="text-muted">Start exploring and book your first stay!</p>

      <a href="/listings" class="btn wander-btn mt-3">
        Explore Listings
      </a>
    </div>
  </div>

<% } else { %>
  <% bookings.forEach(booking => { %>
    <% if (!booking.listing) return; %>
    <div class="card trip-card mb-4 col-6 offset-2 shadow-lg border-0 rounded-4 p-2">
      <div class="row g-0">
        <div class="p-1 col-md-6">
          <a href="/listings/<%= booking.listing._id %>">
            <img src="<%= booking.listing.image.url %>" class="img-fluid rounded" alt="mytrips">
          </a>
        </div>
        <div class="col-md-6">
          <div class="card-body m-2">
            <h5 class="card-title"><%= booking.listing.title %></h5>
            <div class="lh-1 ">
              <p class="card-text">Check-in: <%= booking.checkIn.toDateString() %></p>
              <p class="card-text">Check-out: <%= booking.checkOut.toDateString() %></p>
              <p>Guests: <%= booking.guests %></p>
              <p>Total Price: ₹<%= booking.totalPrice %></p>
            </div>
            <div>
              <%  const today = new Date();%>

              <% const checkIn = new Date(booking.checkIn);%>
              <% const checkOut = new Date(booking.checkOut);%>

             <% if (booking.status === "cancelled") { %>
                <span class="badge bg-danger">Cancelled</span>
            <% } else if (today > checkOut) { %>
                <span class="badge bg-success">Visited</span>
            <% } else if (today >= checkIn && today <= checkOut) { %>
                <span class="badge bg-warning text-dark">Ongoing</span>
            <% } else { %>
                <span class="badge bg-info mb-1">Upcoming</span>
                <form action="/bookings/<%= booking._id %>/cancel" method="POST">
                    <button class="btn wander-btn btn-sm">Cancel my trip</button>
                </form>
            <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
<% } %>