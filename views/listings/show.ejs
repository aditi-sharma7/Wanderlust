<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3 class="fw-medium"><%= listing.title %></h3>
    </div>
    <div class="card col-6 offset-3 show-card listing-card mb-0">
        <img src="<%=listing.image.url%>" 
        class="card-img-top show-img" 
        alt="listing_image"
        >
        <div class="card-body mt-4">
            <p class="card-text">Description : <%= listing.description %> <br></p> 
            <p class="card-text">Price : &#x20b9; <%= listing.price.toLocaleString("en-IN") %>/ night <br></p>   
            <p class="card-text">Location : <%= listing.location %> <br></p>   
            <p class="card-text">Country : <%= listing.country %></p> 
        </div>
        <br>
        <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns d-flex gap-2">
                <a class="btn btn-dark edit-btn col-2" href="/listings/<%=listing._id%>/edit">Edit</a>
                <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark offset-3">Delete</button>
                </form>
            </div>
        <% } %>
        <hr>
            <div class="host-box d-flex align-items-center gap-3 rounded">
                <div class="host-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <p class="mb-0 text-muted small">Hosted by</p>
                    <h6 class="mb-0 fw-semibold"><%= listing.owner.username %></h6>
                </div>
            </div>
        <hr>
        <% if (currUser && currUser._id.toString() !== listing.owner._id.toString()) { %>
            <div class="card-booking shadow-lg border-0 rounded-4 p-4" >
                <form action="/listings/<%= listing._id %>/bookings" 
                    method="POST" 
                    class="needs-validation-reserve"
                    novalidate>
                    <h4 class="fw-bolder mb-3">
                        &#x20b9; <%= listing.price.toLocaleString("en-IN") %> <span class="text-muted fs-6">/ night</span>
                    </h4>

                    <!-- Date box -->
                    <div class="border rounded-3 p-2">
                        <div class="mb-3">
                            <input type="text" id="checkIn" name="booking[checkIn]" class="form-control flatpickr-validation border-0" placeholder="Check-in">
                        </div>                        
                        <hr class="my-2">
                        <div class="mb-3">
                            <input type="text" id="checkOut" name="booking[checkOut]" class="form-control flatpickr-validation border-0" placeholder="Check-out" >
                        </div> 
                                           

                        <!-- Guests -->
                        <div class="d-flex justify-content-between align-items-center border rounded-4 p-3 mt-3" >
                            <div>
                                <p class="mb-0 fw-semibold">Guests</p>
                                <small class="text-muted">Add guests</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-dark rounded-circle guest-btn" onclick="changeGuest(-1)">
                                    −
                                </button>
                                <span id="guestCount" class="fw-semibold fs-5" >1</span>
                                <button type="button" class="btn btn-outline-dark rounded-circle guest-btn" onclick="changeGuest(1)">
                                    +
                                </button>
                            </div>
                        </div>
                        <div class="mt-3 p-2 mb-2">
                            <h5 id="totalDisplay"></h5>
                            <small class="text-muted" id="nightText"></small>
                        </div>


                        <input type="hidden" name="booking[guests]" id="guestInput" value="1">
                        <input type="hidden" id="pricePerNight"  value="<%= listing.price %>">
                        <input type="hidden" name="booking[totalPrice]" id="totalPrice">

                        <!-- Button -->
                        <button type="submit" class="btn book-btn w-100 rounded-pill fw-semibold">
                            <i class="fa-solid fa-bag-shopping"></i>&nbsp;
                            Reserve
                        </button>

                        <p class="text-center text-muted mt-2 small">
                            You won't be charged yet
                        </p>
                    </div>
                </form>
            </div>
        <% } %>
    </div>
    <div class="col-6 offset-3 mb-3">
        <% if(currUser) { %>
            <hr>
            <h4>Leave a Review</h4>
            <form method="post" action="/listings/<%=listing.id%>/reviews" novalidate class="needs-validation"> 
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please add some comments for review.
                    </div> 
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
        <% } %>
        <% if(listing.reviews.length > 0){ %>
            <div class="row">
                <p><b>All Reviews</b></p>
                <% for(review of listing.reviews){ %>
                    <div class="card col-5 ms-4 mb-3">
                        <div class="card-body mb-2">
                            <h5 class="card-title">@<%=review.author.username%></h5>
                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>             
                            <p class="card-text"><%= review.comment%></p>
                        </div>
                       <% if(currUser && currUser._id.equals(review.author._id)) { %>
                            <form class="mb-3" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% } %>
        <hr >
    </div>
    <div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map">
        </div>
        <script>
            const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
            const listingTitle = "<%= listing.title %>";
            const listingLocation = "<%= listing.location %>";
        </script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="/js/map.js"></script>
    </div>
</div>
<script src="/js/booking.js"></script>
