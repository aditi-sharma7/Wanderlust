<% layout("/layouts/boilerplate") -%>
     <div class="filters-container">
     <div id="filters" class="d-flex">
        <div class="filter">
            <a href="/listings/category/Rooms"  class="nav-link">
                <div><i class="fa-solid fa-bed"></i></div>
                Rooms
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Mountains"  class="nav-link">
                <div><i class="fa-solid fa-mountain"></i></div>
                Mountains
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Castles" class="nav-link">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                Castles
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Camping"  class="nav-link">
                <div><i class="fa-solid fa-campground"></i></div>
                Camping
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Farms" class="nav-link">
                <div><i class="fa-solid fa-cow"></i></div>
                Farms
            </a>
        </div>
         <div class="filter">
            <a href="/listings/category/Iconic" class="nav-link">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                Iconic Cities
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Arctic"  class="nav-link">
                <div><i class="fa-solid fa-snowflake"></i></div>
                Arctic
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Trending"  class="nav-link">
                <div><i class="fa-solid fa-fire"></i></div>
                Trending
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Domes"  class="nav-link">
                <div><i class="fa-solid fa-igloo"></i></div>
                Domes
            </a>
        </div>
        <div class="filter">
            <a href="/listings/category/Boats"  class="nav-link">
                <div><i class="fa-solid fa-ship"></i></div>
                Boats
            </a>
        </div>
     </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay">                    
                </div>
                <div class="card-body">
                <p class="card-text">
                    <b><%=listing.title%></b><br>
                    &#x20b9; <%= listing.price.toLocaleString("en-IN") %> / night
                </p>
                </div>
                </div>
            </a>
        <%}%>        
    </div>

    
