<% layout('layouts/boilerplate') %>

<div class="container mt-4 mb-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-semibold mb-0">My Mood DNA</h2>
          <p class="text-muted">Your travel mood history</p>
        </div>
        <!-- <a href="/mood" class="btn btn-dark">+ New Trip</a> -->
      </div>


      <% if (trips.length === 0) { %>
        <div class="text-center text-muted pt-5">
          <p>No mood trips yet.</p>
          <a href="/mood" class="btn wander-btn btn-outline-danger">
            Generate your first one
          </a>
        </div>
      <% } else { %>
        <% for (let trip of trips) { %>
          <div class="card mb-4 shadow-sm" style="border-radius:16px; overflow:hidden;">
            <div class="card-body p-4">

              <!-- Header -->
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <span class="badge mb-2" style="background:#eeedfe; color:#534ab7; font-size:0.75rem;">
                    <%= trip.moodLabel %>
                  </span>
                  <h5 class="fw-bold mb-1"><%= trip.destination %></h5>
                  <p class="text-muted" style="font-size:0.9rem;"><%= trip.tagline %></p>
                </div>
                <!-- Delete -->
                <form action="/mood/<%= trip._id %>?_method=DELETE" method="POST">
                  <button class="btn btn-sm btn-outline-danger">✕</button>
                </form>
              </div>

              <!-- Palette -->
              <div class="d-flex gap-2 mb-3">
                <% for (let color of trip.palette) { %>
                  <div style="width:24px; height:24px; border-radius:50%; background:<%= color %>;"></div>
                <% } %>
              </div>

              <!-- Itinerary -->
              <% for (let day of trip.itinerary) { %>
                <div class="d-flex gap-3 align-items-start mb-2">
                  <div style="width:26px; height:26px; border-radius:50%; background:#eeedfe; color:#534ab7; font-size:0.75rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-weight:600;">
                    <%= day.day %>
                  </div>
                  <p class="mb-0" style="font-size:0.9rem;"><%= day.plan %></p>
                </div>
              <% } %>

              <!-- Best Time to Visit -->
              <% if (trip.bestTimeToVisit && trip.bestTimeToVisit.months.length) { %>
                <div class="mt-3 mb-2">
                  <p class="fw-semibold mb-1" style="font-size:0.75rem; text-transform:uppercase; color:#6c63ff;">Best Time to Visit</p>
                  <div class="mb-1 mt-2">
                    <% for (let m of trip.bestTimeToVisit.months) { %>
                      <span class="badge me-1" style="background:#eeedfe; color:#534ab7;"><%= m %></span>
                    <% } %>
                  </div>
                  <p class="mb-0 ms-1" style="font-size:14px;"><%= trip.bestTimeToVisit.weather %></p>
                  <% if (trip.bestTimeToVisit.avoidMonths.length) { %>
                    <p class="mb-0 ms-1" style="font-size:14px;">
                      <b>Avoid:</b> <%= trip.bestTimeToVisit.avoidMonths.join(", ") %> — <%= trip.bestTimeToVisit.avoidReason %>
                    </p>
                  <% } %>
                </div>
              <% } %>

              <!-- Packing List -->
              <% if (trip.packingList && trip.packingList.essentials.length) { %>
                <div class="mt-2 mb-3">
                  <p class="fw-semibold mb-1" style="font-size:0.75rem; text-transform:uppercase; color:#6c63ff;">Packing List</p>
                  <% const categories = ["essentials","clothing","accessories","toiletries","documents"]; %>
                  <% for (let cat of categories) { %>
                    <% if (trip.packingList[cat] && trip.packingList[cat].length) { %>
                      <p class="mb-1 mt-1 fw-semibold badge me-1" style="font-size:0.8rem; text-transform:capitalize; background:#eeedfe; color:#534ab7;"><%= cat %></p>
                      <div class="mb-2">
                        <% for (let item of trip.packingList[cat]) { %>
                          <span class="ms-1 mb-1" style="font-weight: 400; font-size:14px;">- <%= item %></span><br>
                        <% } %>
                      </div>
                    <% } %>
                  <% } %>
                </div>
              <% } %>

              <!-- Mood Tags -->
              <div class="mt-3 mb-3">
                 <p class="fw-semibold mb-1" style="font-size:0.75rem; text-transform:uppercase; color:#6c63ff;">Mood Tags</p>
                <% for (let tag of trip.moodTags) { %>
                  <span class="badge me-1" style="background:#eeedfe; color:#534ab7;"><%= tag %></span>
                <% } %>
              </div>

              <!-- Mood Log -->
              <% if (trip.actualMoodLog) { %>
                <div class="alert alert-light mt-2 mb-0" style="font-size:0.85rem;">
                  <strong>How I actually felt:</strong> <%= trip.actualMoodLog %>
                </div>
              <% } else { %>
                <form action="/mood/<%= trip._id %>/log?_method=PATCH" method="POST" class="mt-3 needs-validation" novalidate>
                  <div class="input-group">
                    <input
                      type="text"
                      name="actualMoodLog"
                      class="form-control form-control-sm"
                      placeholder="How did you actually feel on this trip?"
                      required
                    />
                    <button class="btn btn-sm wander-btn btn-outline-danger" type="submit">Save Log</button>
                    <div class="invalid-feedback">
                      Please share your experience.
                    </div>
                  </div>
                </form>
              <% } %>

            </div>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>
</div>