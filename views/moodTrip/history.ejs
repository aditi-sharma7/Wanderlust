<% layout('layouts/boilerplate') %>

<div class="container mt-4 mb-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-semibold mb-0">My Mood DNA</h2>
          <p class="text-muted">Your travel mood history</p>
        </div>
        <a href="/mood" class="btn btn-dark">+ New Trip</a>
      </div>


      <% if (trips.length === 0) { %>
        <div class="text-center text-muted pt-5">
          <p>No mood trips yet.</p>
          <a href="/mood" class="btn wander-btn">
            Generate your first one
          </a>
        </div>
      <% } else { %>
        <% for (let trip of trips) { %>
          <div class="card mb-4 shadow-sm" style="border-radius:16px; overflow:hidden;">
            <div class="card-body p-4">

              <!-- Header -->
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <span class="badge mb-2" style="background:#eeedfe; color:#534ab7; font-size:0.75rem;">
                    <%= trip.moodLabel %>
                  </span>
                  <h5 class="fw-bold mb-1"><%= trip.destination %></h5>
                  <p class="text-muted" style="font-size:0.9rem;"><%= trip.tagline %></p>
                </div>
                <!-- Delete -->
                <form action="/mood/<%= trip._id %>?_method=DELETE" method="POST">
                  <button class="btn btn-sm btn-outline-danger">✕</button>
                </form>
              </div>

              <!-- Palette -->
              <div class="d-flex gap-2 mb-3">
                <% for (let color of trip.palette) { %>
                  <div style="width:24px; height:24px; border-radius:50%; background:<%= color %>;"></div>
                <% } %>
              </div>

              <!-- Itinerary -->
              <% for (let day of trip.itinerary) { %>
                <div class="d-flex gap-3 align-items-start mb-2">
                  <div style="width:26px; height:26px; border-radius:50%; background:#eeedfe; color:#534ab7; font-size:0.75rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-weight:600;">
                    <%= day.day %>
                  </div>
                  <p class="mb-0" style="font-size:0.9rem;"><%= day.plan %></p>
                </div>
              <% } %>

              <!-- Mood Tags -->
              <div class="mt-3 mb-3">
                <% for (let tag of trip.moodTags) { %>
                  <span class="badge me-1" style="background:#eeedfe; color:#534ab7;"><%= tag %></span>
                <% } %>
              </div>

              <!-- Mood Log -->
              <% if (trip.actualMoodLog) { %>
                <div class="alert alert-light mt-2 mb-0" style="font-size:0.85rem;">
                  <strong>How I actually felt:</strong> <%= trip.actualMoodLog %>
                </div>
              <% } else { %>
                <form action="/mood/<%= trip._id %>/log?_method=PATCH" method="POST" class="mt-3 needs-validation" novalidate>
                  <div class="input-group">
                    <input
                      type="text"
                      name="actualMoodLog"
                      class="form-control form-control-sm"
                      placeholder="How did you actually feel on this trip?"
                      required
                    />
                    <button class="btn btn-sm btn-outline-dark" type="submit">Save Log</button>
                    <div class="invalid-feedback">
                      Please enter your experience.
                    </div>
                  </div>
                </form>
              <% } %>

            </div>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>
</div>